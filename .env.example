POSTGRES_URL=postgres://...
GEMINI_API_KEY=your-gemini-key
BLOB_READ_WRITE_TOKEN=vercel-blob-token

# ── 고객 알림(알림톡/문자) 발송 — 솔라피(SOLAPI) ─────────────────────────────
# 아래 두 키가 없으면 dry_run 모드: 실발송 없이 notification_log 에 기록만 남고 전체 파이프라인은 그대로 동작
SOLAPI_API_KEY=NCS...                     # 솔라피 API Key (console.solapi.com > API Key 관리)
SOLAPI_API_SECRET=...                     # 솔라피 API Secret (HMAC-SHA256 서명에 사용)
KAKAO_PF_ID=...                           # 카카오 비즈니스 채널 pfId (알림톡 발신 프로필). 없으면 LMS 직발송
SOLAPI_TPL_ORDERED=KA01TP...              # 알림톡 템플릿 ID — ① 주문 접수 안내
SOLAPI_TPL_STARTED=KA01TP...              # 알림톡 템플릿 ID — ② 제작 시작 안내 (NOTIFY_STARTED=1 일 때만 발송)
SOLAPI_TPL_PACKED=KA01TP...               # 알림톡 템플릿 ID — ③ 포장 완료 안내
SOLAPI_TPL_SHIPPED=KA01TP...              # 알림톡 템플릿 ID — ④ 출고 완료 안내
SOLAPI_TPL_RESCHEDULED=KA01TP...          # 알림톡 템플릿 ID — ⑤ 출고예정일 조정 안내
SMS_SENDER=07000000000                    # 사전 등록된 발신번호 (템플릿 없을 때 LMS 직발송 + 알림톡 문자 대체발송에 필수)
ADMIN_PHONES=01000000000,01011111111      # 납기 리스크 일일 리포트 수신 관리자 번호 (콤마 구분 복수)
CRON_SECRET=random-long-secret            # 크론 엔드포인트 인증 시크릿 (Vercel Cron 이 Bearer 로 자동 첨부)
BASE_URL=https://production-status.vercel.app  # 고객 조회 링크(/track/{token}) 생성 기준 URL
NOTIFY_STARTED=0                          # '1' 이면 최초 공정 시작 시 '제작 시작' 알림 발송 (기본 미발송)

# [크론 스케줄 참고]
# vercel.json 의 crons: sweep 매일 23:30 UTC(=KST 08:30, 조용시간 대기분 발송 + 누락 복구 + 실패 재시도),
# risk-daily 매일 23:40 UTC(=KST 08:40, 납기 리스크 관리자 요약 LMS).
# Vercel Hobby 플랜 제한: 크론 잡 최대 2개(현재 딱 2개 등록), 각 잡은 하루 1회만 실행되고
# 실행 시각이 분 단위로 정확하지 않을 수 있음(지정 시각 이후 1시간 내 실행).
# 더 정확한 시각/추가 스케줄이 필요하면 외부 스케줄러(GitHub Actions 등)에서
# Authorization: Bearer {CRON_SECRET} 헤더로 /api/cron/* 를 호출해도 동일하게 동작.
# 조용시간 정책: KST 08:00~21:00 밖에는 고객 발송을 하지 않고 queued 로 보관 → 아침 sweep 이 발송.
