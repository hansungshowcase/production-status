POSTGRES_URL=postgres://...
SALES_PASSWORD=change-me
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-random-secret
GEMINI_API_KEY=your-gemini-key
BLOB_READ_WRITE_TOKEN=vercel-blob-token

# ── 고객 알림(솔라피) / 조회페이지 / 크론 ──
BASE_URL=https://production-status.vercel.app          # 조회링크 도메인
SOLAPI_API_KEY=                                        # 솔라피 API Key (없으면 dry_run: 발송 안 하고 기록만)
SOLAPI_API_SECRET=                                     # 솔라피 API Secret
SMS_SENDER=                                            # 등록된 발신번호(숫자만) — 문자/LMS 발송용
ADMIN_PHONES=                                          # 납기위험 아침리포트 수신 번호(콤마 구분)
CRON_SECRET=                                           # /api/cron/* 인증 (Vercel Cron이 Bearer로 자동 첨부)
NOTIFY_STARTED=                                        # '1'이면 제작시작 알림도 발송(선택)
NOTIFY_BACKFILL=                                       # 'on'이면 sweep이 과거 도달건 소급발송(기본 off=신규만)
KAKAO_PF_ID=                                           # 카카오 발신프로필 ID (알림톡 심사통과 후)
SOLAPI_TPL_ORDERED=                                    # 알림톡 템플릿 코드(승인 후) — 접수
SOLAPI_TPL_STARTED=                                    # 제작시작
SOLAPI_TPL_PACKED=                                     # 포장완료
SOLAPI_TPL_SHIPPED=                                    # 출고완료
SOLAPI_TPL_RESCHEDULED=                                # 출고예정일 조정

# ── 구글 시트 연동 ──
GOOGLE_SHEETS_WEBHOOK_URL=                             # 등록/삭제용 Apps Script 웹앱 URL (.apps-script-sheet) — 미설정 시 코드 기본값 사용
GOOGLE_SHEETS_SHIPPING_WEBHOOK_URL=                    # 출고완료 E열 기입 전용 Apps Script 웹앱 URL (.apps-script-shipping) — 미설정 시 출고 동기화만 실패(주문 처리는 정상)
GOOGLE_SHEETS_WEBHOOK_SECRET=                          # 두 웹앱 공통 시크릿 (Code.js의 SECRET과 동일해야 함, 기본값 hansung-production-status)
